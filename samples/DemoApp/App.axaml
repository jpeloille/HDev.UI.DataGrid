<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DemoApp.App"
             RequestedThemeVariant="Light">

  <Application.Styles>
    <!-- Base Fluent theme (required as foundation) -->
    <FluentTheme />

    <!-- DataGrid component styles -->
    <StyleInclude Source="avares://HDev.UI.DataGrid/Themes/Index.axaml" />

    <!-- App-specific styles (ribbon, etc.) -->
    <StyleInclude Source="avares://DemoApp/Themes/Styles.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- WinXI Theme Bundle - colors, tokens, and control themes -->
        <ResourceInclude Source="avares://DemoApp/Themes/WinXIThemeBundle.axaml" />

        <!-- Control styles for CardPanel and Ribbon -->
        <ResourceInclude Source="avares://DemoApp/Themes/Controls/CardPanel.axaml" />
        <ResourceInclude Source="avares://DemoApp/Themes/Controls/RibbonControl.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
