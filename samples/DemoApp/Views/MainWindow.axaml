<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DemoApp.ViewModels"
        xmlns:controls="using:DemoApp.Controls"
        xmlns:jdg="using:Julien.Avalonia.DataGrid.Controls"
        xmlns:models="using:Julien.Avalonia.DataGrid.Models"
        x:Class="DemoApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Rounded Skin Panels | JDataGrid"
        Width="1400" Height="900"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        SystemDecorations="BorderOnly"
        Background="{DynamicResource PageBackgroundBrush}">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- Row 0: Title Bar with App Icon and Window Buttons -->
    <Border Grid.Row="0"
            Background="{DynamicResource TitleBarBackgroundBrush}"
            Height="40">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <!-- App Icon -->
        <Border Grid.Column="0"
                Margin="12,0,8,0"
                VerticalAlignment="Center">
          <Grid Width="20" Height="20">
            <Rectangle Fill="White" Width="8" Height="8" Margin="0,0,6,6" HorizontalAlignment="Left" VerticalAlignment="Top" />
            <Rectangle Fill="White" Width="8" Height="8" Margin="6,0,0,6" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Rectangle Fill="White" Width="8" Height="8" Margin="0,6,6,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
            <Rectangle Fill="White" Width="8" Height="8" Margin="6,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
          </Grid>
        </Border>

        <!-- Ribbon Tabs -->
        <controls:Ribbon x:Name="MainRibbon"
                         Grid.Column="1"
                         SelectedIndex="0">
          <controls:RibbonTab Header="View" />
        </controls:Ribbon>

        <!-- Draggable Title Area -->
        <Border Grid.Column="2"
                Background="Transparent"
                PointerPressed="TitleBar_PointerPressed">
          <TextBlock Text="Rounded Skin Panels | JDataGrid"
                     Foreground="{DynamicResource TitleBarForegroundBrush}"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     FontWeight="SemiBold" />
        </Border>

        <!-- Window Buttons -->
        <StackPanel Grid.Column="3" Orientation="Horizontal">
          <Button Classes="titleBarButton" Click="MinimizeButton_Click">
            <Path Width="10" Height="10"
                  Data="M0,5 L10,5"
                  Stroke="{DynamicResource TitleBarForegroundBrush}"
                  StrokeThickness="1" />
          </Button>
          <Button Classes="titleBarButton" Click="MaximizeButton_Click">
            <Path Width="10" Height="10"
                  Data="M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z"
                  Stroke="{DynamicResource TitleBarForegroundBrush}"
                  StrokeThickness="1" />
          </Button>
          <Button Classes="titleBarButton closeButton" Click="CloseButton_Click">
            <Path Width="10" Height="10"
                  Data="M0,0 L10,10 M10,0 L0,10"
                  Stroke="{DynamicResource TitleBarForegroundBrush}"
                  StrokeThickness="1" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Row 1: Ribbon Content -->
    <Border Grid.Row="1"
            Background="{DynamicResource RibbonBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4"
            MinHeight="90">
      <StackPanel Orientation="Horizontal">

        <!-- Skin Selector Group -->
        <controls:RibbonGroup GroupLabel="Skins">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <!-- WXI Dropdown placeholder -->
            <Border Width="40"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="4"
                    VerticalAlignment="Center">
              <StackPanel HorizontalAlignment="Center" Spacing="2">
                <Grid Width="20" Height="20">
                  <Rectangle Fill="{DynamicResource AccentBrush}" Width="8" Height="8" Margin="0,0,6,6" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <Rectangle Fill="{DynamicResource AccentBrush}" Width="8" Height="8" Margin="6,0,0,6" HorizontalAlignment="Right" VerticalAlignment="Top" />
                  <Rectangle Fill="{DynamicResource AccentBrush}" Width="8" Height="8" Margin="0,6,6,0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                  <Rectangle Fill="{DynamicResource AccentBrush}" Width="8" Height="8" Margin="6,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock Text="WXI" FontSize="9" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <PathIcon Width="8" Height="8"
                          Data="M0,0 L4,4 L8,0"
                          Foreground="{DynamicResource TextSecondaryBrush}" />
              </StackPanel>
            </Border>

            <!-- Skin Thumbnails -->
            <ListBox ItemsSource="{Binding AvailableSkins}"
                     SelectedItem="{Binding SelectedSkin}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type controls:SkinInfo}">
                  <Border Width="70" Height="50"
                          CornerRadius="4"
                          ClipToBounds="True"
                          Cursor="Hand">
                    <Grid RowDefinitions="*,*">
                      <Border Grid.Row="0">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding AccentColor}" />
                        </Border.Background>
                      </Border>
                      <Border Grid.Row="1">
                        <Border.Background>
                          <SolidColorBrush Color="{Binding TertiaryColor}" />
                        </Border.Background>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="2" />
                  <Setter Property="Margin" Value="0" />
                  <Setter Property="CornerRadius" Value="6" />
                  <Setter Property="BorderThickness" Value="2" />
                  <Setter Property="BorderBrush" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                  <Setter Property="Background" Value="Transparent" />
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Style>
              </ListBox.Styles>
            </ListBox>

            <!-- Scroll buttons -->
            <StackPanel VerticalAlignment="Center" Margin="4,0,0,0">
              <Button Background="Transparent" BorderThickness="0" Padding="4,2">
                <PathIcon Width="8" Height="8" Data="M0,4 L4,0 L8,4" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Button>
              <Button Background="Transparent" BorderThickness="0" Padding="4,2">
                <PathIcon Width="8" Height="8" Data="M0,0 L4,4 L8,0" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Button>
              <Button Background="Transparent" BorderThickness="0" Padding="4,2">
                <PathIcon Width="8" Height="8" Data="M0,4 L4,0 L8,4 M0,8 L4,4 L8,8" Foreground="{DynamicResource TextSecondaryBrush}" />
              </Button>
            </StackPanel>
          </StackPanel>
        </controls:RibbonGroup>

        <!-- View Options Group -->
        <controls:RibbonGroup GroupLabel="View Options">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <ToggleButton Content="Filter Row"
                          IsChecked="{Binding ShowFilterRow}"
                          Classes="ribbonToggle" />
            <ToggleButton Content="Group Panel"
                          IsChecked="{Binding ShowGroupPanel}"
                          Classes="ribbonToggle" />
            <ToggleButton Content="Row Numbers"
                          IsChecked="{Binding ShowRowNumbers}"
                          Classes="ribbonToggle" />
          </StackPanel>
        </controls:RibbonGroup>

        <!-- Data Operations Group -->
        <controls:RibbonGroup GroupLabel="Data">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="Refresh" Command="{Binding RefreshDataCommand}" Classes="ribbonButton" />
            <Button Content="Add" Command="{Binding AddEmployeeCommand}" Classes="ribbonButton" />
            <Button Content="Delete"
                    Command="{Binding DeleteEmployeeCommand}"
                    IsEnabled="{Binding SelectedEmployee, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Classes="ribbonButton" />
          </StackPanel>
        </controls:RibbonGroup>

        <!-- Dataset Size Group -->
        <controls:RibbonGroup GroupLabel="Dataset">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Button Content="100" Command="{Binding LoadSmallDatasetCommand}" Classes="ribbonButton" MinWidth="40" />
            <Button Content="1K" Command="{Binding LoadMediumDatasetCommand}" Classes="ribbonButton" MinWidth="40" />
            <Button Content="10K" Command="{Binding LoadLargeDatasetCommand}" Classes="ribbonButton" MinWidth="40" />
            <Button Content="100K" Command="{Binding LoadVeryLargeDatasetCommand}" Classes="ribbonButton" MinWidth="40" />
          </StackPanel>
        </controls:RibbonGroup>

        <!-- Collapse Ribbon Button -->
        <Border VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,4,8,0">
          <Button Background="Transparent"
                  BorderThickness="0"
                  Padding="8,4">
            <PathIcon Width="12" Height="12"
                      Data="M0,8 L6,2 L12,8"
                      Foreground="{DynamicResource TextSecondaryBrush}" />
          </Button>
        </Border>

      </StackPanel>
    </Border>

    <!-- Row 2: Main Content Area -->
    <Grid Grid.Row="2" ColumnDefinitions="*,350" Margin="8">

      <!-- Left Panel: Navigation Tree (placeholder) -->
      <Grid Grid.Column="0" ColumnDefinitions="200,*">

        <!-- Tree View Panel -->
        <controls:CardPanel Grid.Column="0"
                            ShowHeader="False"
                            Margin="0,0,8,0">
          <TreeView Margin="8">
            <TreeViewItem Header="Employees" IsExpanded="True">
              <TreeViewItem Header="All Employees" />
              <TreeViewItem Header="By Department" />
              <TreeViewItem Header="By Country" />
            </TreeViewItem>
            <TreeViewItem Header="Reports">
              <TreeViewItem Header="Salary Report" />
              <TreeViewItem Header="Performance" />
            </TreeViewItem>
          </TreeView>
        </controls:CardPanel>

        <!-- DataGrid Panel -->
        <controls:CardPanel Grid.Column="1"
                            Title="Employees"
                            ShowSearch="True"
                            SearchWatermark="Search employees..."
                            ShowHeader="True">
          <jdg:JDataGrid ItemsSource="{Binding Employees}"
                         SelectedItem="{Binding SelectedEmployee}"
                         ShowFilterRow="{Binding ShowFilterRow}"
                         ShowGroupPanel="{Binding ShowGroupPanel}"
                         ShowRowNumbers="{Binding ShowRowNumbers}"
                         IsLoading="{Binding IsLoading}"
                         AllowSorting="True"
                         AllowFiltering="True"
                         AllowGrouping="True"
                         AllowEditing="True"
                         AllowColumnResizing="True"
                         AllowColumnReordering="True"
                         AutoGenerateColumns="False"
                         RowHeight="32"
                         HeaderHeight="36">

            <jdg:JDataGrid.Columns>
              <models:GridColumn FieldName="Id"
                                 Header="ID"
                                 Width="60"
                                 IsReadOnly="True"
                                 TextAlignment="Right" />

              <models:GridColumn FieldName="FirstName"
                                 Header="First Name"
                                 Width="120" />

              <models:GridColumn FieldName="LastName"
                                 Header="Last Name"
                                 Width="120" />

              <models:GridColumn FieldName="Email"
                                 Header="Email"
                                 Width="200" />

              <models:GridColumn FieldName="Department"
                                 Header="Department"
                                 Width="120"
                                 AllowGroup="True" />

              <models:GridColumn FieldName="Position"
                                 Header="Position"
                                 Width="100" />

              <models:GridColumn FieldName="HireDate"
                                 Header="Hire Date"
                                 Width="100"
                                 ColumnType="DateTime"
                                 FormatString="d" />

              <models:GridColumn FieldName="Salary"
                                 Header="Salary"
                                 Width="100"
                                 ColumnType="Numeric"
                                 FormatString="C0"
                                 TextAlignment="Right" />

              <models:GridColumn FieldName="IsActive"
                                 Header="Active"
                                 Width="60"
                                 ColumnType="Boolean"
                                 TextAlignment="Center" />

              <models:GridColumn FieldName="PerformanceRating"
                                 Header="Rating"
                                 Width="70"
                                 ColumnType="Numeric"
                                 TextAlignment="Center" />

              <models:GridColumn FieldName="Country"
                                 Header="Country"
                                 Width="120"
                                 AllowGroup="True" />
            </jdg:JDataGrid.Columns>

          </jdg:JDataGrid>
        </controls:CardPanel>
      </Grid>

      <!-- Right Panel: Details -->
      <controls:CardPanel Grid.Column="1"
                          Title="Employee Details"
                          ShowSearch="False"
                          ShowHeader="True">
        <ScrollViewer>
          <StackPanel Spacing="12"
                      Margin="16"
                      IsVisible="{Binding SelectedEmployee, Converter={x:Static ObjectConverters.IsNotNull}}">

            <StackPanel Spacing="8">
              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="ID: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Id}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Name: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.FullName}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Email: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Email}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Department: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Department}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Position: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Position}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Hire Date: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.HireDate, StringFormat='{}{0:d}'}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Salary: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Salary, StringFormat='{}{0:C0}'}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Active: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.IsActive}" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Rating: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.PerformanceRating}" />
                <Run Text="/5" />
              </TextBlock>

              <TextBlock Foreground="{DynamicResource TextPrimaryBrush}">
                <Run Text="Country: " FontWeight="SemiBold" />
                <Run Text="{Binding SelectedEmployee.Country}" />
              </TextBlock>
            </StackPanel>

            <Separator Margin="0,8" />

            <!-- Edit Section -->
            <TextBlock Text="Quick Edit"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,8" />

            <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="First Name:"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedEmployee.FirstName}" />

              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="Last Name:"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEmployee.LastName}" />

              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="Salary:"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <NumericUpDown Grid.Row="2" Grid.Column="1"
                             Value="{Binding SelectedEmployee.Salary}"
                             FormatString="C0"
                             Minimum="0" />

              <TextBlock Grid.Row="3" Grid.Column="0"
                         Text="Active:"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
              <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding SelectedEmployee.IsActive}" />
            </Grid>

          </StackPanel>
        </ScrollViewer>
      </controls:CardPanel>

    </Grid>

    <!-- Row 3: Status Bar -->
    <Border Grid.Row="3"
            Background="{DynamicResource RibbonBackgroundBrush}"
            BorderBrush="{DynamicResource SeparatorBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding StatusText}"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Column="1"
                   Text="JDataGrid Demo v1.0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

  </Grid>

  <Window.Styles>
    <!-- Title Bar Button Styles -->
    <Style Selector="Button.titleBarButton">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.titleBarButton:pointerover">
      <Setter Property="Background" Value="#20FFFFFF" />
    </Style>

    <Style Selector="Button.closeButton:pointerover">
      <Setter Property="Background" Value="#E81123" />
    </Style>
  </Window.Styles>

</Window>
