<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         WINXI THEME BUNDLE
         Import this single file to get the complete DevExpress WinXI-style theme
         ═══════════════════════════════════════════════════════════════════════ -->

    <ResourceDictionary.MergedDictionaries>

        <!-- Base theme (colors, tokens, core controls) -->
        <ResourceInclude Source="WinXITheme.axaml" />

        <!-- Extended controls -->
        <ResourceInclude Source="Controls/WinXINavigation.axaml" />
        <ResourceInclude Source="Controls/WinXIComponents.axaml" />

    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
