<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════════
         WINXI DEVEXPRESS-STYLE THEME FOR AVALONIA UI
         A modern, polished Windows 11-inspired theme with DevExpress refinements
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                        COLOR PALETTE                              ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <!-- Primary Accent Colors -->
    <Color x:Key="AccentColor">#0078D4</Color>
    <Color x:Key="AccentColorLight">#429CE3</Color>
    <Color x:Key="AccentColorDark">#005A9E</Color>
    <Color x:Key="AccentColorPressed">#004578</Color>
    
    <!-- Background Colors (Mica-inspired) -->
    <Color x:Key="MicaBackgroundColor">#F3F3F3</Color>
    <Color x:Key="MicaBackgroundDarkColor">#202020</Color>
    <Color x:Key="LayerBackgroundColor">#FFFFFF</Color>
    <Color x:Key="LayerBackgroundDarkColor">#2D2D2D</Color>
    <Color x:Key="CardBackgroundColor">#FAFAFA</Color>
    <Color x:Key="CardBackgroundDarkColor">#323232</Color>
    
    <!-- Surface Colors -->
    <Color x:Key="SurfacePrimaryColor">#FFFFFF</Color>
    <Color x:Key="SurfaceSecondaryColor">#F9F9F9</Color>
    <Color x:Key="SurfaceTertiaryColor">#F3F3F3</Color>
    <Color x:Key="SurfaceStrokeColor">#E5E5E5</Color>
    <Color x:Key="SurfaceStrokeColorDark">#3D3D3D</Color>
    
    <!-- Text Colors -->
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#5C5C5C</Color>
    <Color x:Key="TextTertiaryColor">#8A8A8A</Color>
    <Color x:Key="TextDisabledColor">#A0A0A0</Color>
    <Color x:Key="TextOnAccentColor">#FFFFFF</Color>
    
    <!-- State Colors -->
    <Color x:Key="HoverOverlayColor">#0A000000</Color>
    <Color x:Key="PressedOverlayColor">#12000000</Color>
    <Color x:Key="SelectedOverlayColor">#15000000</Color>
    <Color x:Key="FocusBorderColor">#0078D4</Color>
    
    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#0F7B0F</Color>
    <Color x:Key="WarningColor">#9D5D00</Color>
    <Color x:Key="ErrorColor">#C42B1C</Color>
    <Color x:Key="InfoColor">#0078D4</Color>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                         BRUSHES                                   ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentColorLight}" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="{StaticResource AccentColorDark}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentColorPressed}" />
    
    <SolidColorBrush x:Key="MicaBackgroundBrush" Color="{StaticResource MicaBackgroundColor}" />
    <SolidColorBrush x:Key="LayerBackgroundBrush" Color="{StaticResource LayerBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    
    <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{StaticResource SurfaceSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceTertiaryBrush" Color="{StaticResource SurfaceTertiaryColor}" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{StaticResource SurfaceStrokeColor}" />
    
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="{StaticResource TextOnAccentColor}" />
    
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="PressedOverlayBrush" Color="{StaticResource PressedOverlayColor}" />
    <SolidColorBrush x:Key="SelectedOverlayBrush" Color="{StaticResource SelectedOverlayColor}" />
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{StaticResource FocusBorderColor}" />
    
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Application-specific aliases (for backwards compatibility) -->
    <Color x:Key="TitleBarBackground">#0078D4</Color>
    <Color x:Key="TitleBarForeground">#FFFFFF</Color>
    <Color x:Key="RibbonBackground">#F3F3F3</Color>
    <Color x:Key="PageBackground">#F0F0F0</Color>
    <Color x:Key="SeparatorColor">#E5E5E5</Color>
    <Color x:Key="CardBorder">#E5E5E5</Color>

    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="{StaticResource TitleBarBackground}" />
    <SolidColorBrush x:Key="TitleBarForegroundBrush" Color="{StaticResource TitleBarForeground}" />
    <SolidColorBrush x:Key="RibbonBackgroundBrush" Color="{StaticResource RibbonBackground}" />
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackground}" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="{StaticResource SeparatorColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorder}" />
    <SolidColorBrush x:Key="RibbonTabBackgroundBrush" Color="{StaticResource SurfacePrimaryColor}" />
    <SolidColorBrush x:Key="RibbonTabActiveIndicatorBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="RibbonGroupBorderBrush" Color="{StaticResource SurfaceStrokeColor}" />

    <!-- Gradient Brushes -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AccentColorLight}" Offset="0" />
        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
    </LinearGradientBrush>
    
    <LinearGradientBrush x:Key="SubtleGradientBrush" StartPoint="0%,0%" EndPoint="0%,100%">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#F8F8F8" Offset="1" />
    </LinearGradientBrush>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                    DESIGN TOKENS                                  ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <!-- Corner Radius -->
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadiusLarge">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    
    <!-- Thickness -->
    <Thickness x:Key="ControlBorderThickness">1</Thickness>
    <Thickness x:Key="ControlBorderThicknessBottom">0,0,0,1</Thickness>
    <Thickness x:Key="FocusBorderThickness">2</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ControlPadding">11,5,11,6</Thickness>
    <Thickness x:Key="ButtonPadding">11,5,11,6</Thickness>
    
    <!-- Shadows (DevExpress-style subtle elevation) -->
    <BoxShadows x:Key="CardShadow">0 2 8 0 #18000000</BoxShadows>
    <BoxShadows x:Key="CardShadowHover">0 4 16 0 #20000000</BoxShadows>
    <BoxShadows x:Key="PopupShadow">0 8 32 0 #30000000</BoxShadows>
    <BoxShadows x:Key="DialogShadow">0 16 48 0 #40000000</BoxShadows>
    <BoxShadows x:Key="ButtonShadow">0 1 3 0 #10000000</BoxShadows>
    
    <!-- Typography -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="SubtitleFontSize">16</x:Double>
    <x:Double x:Key="TitleFontSize">20</x:Double>
    <x:Double x:Key="HeaderFontSize">28</x:Double>
    <x:Double x:Key="DisplayFontSize">34</x:Double>
    
    <FontWeight x:Key="RegularFontWeight">Normal</FontWeight>
    <FontWeight x:Key="MediumFontWeight">Medium</FontWeight>
    <FontWeight x:Key="SemiBoldFontWeight">SemiBold</FontWeight>
    <FontWeight x:Key="BoldFontWeight">Bold</FontWeight>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                      BUTTON STYLES                                ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <!-- Primary Button (Accent) -->
    <ControlTheme x:Key="WinXIPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource MediumFontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{StaticResource ButtonShadow}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource AccentLightBrush}" />
        </Style>
        
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource AccentDarkBrush}" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
    
    <!-- Secondary Button (Outlined) -->
    <ControlTheme x:Key="WinXISecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ControlBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource MediumFontWeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="Cursor" Value="Hand" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        BoxShadow="{StaticResource ButtonShadow}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource SurfaceSecondaryBrush}" />
        </Style>
        
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource SurfaceTertiaryBrush}" />
            <Setter Property="BoxShadow" Value="none" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>
    
    <!-- Subtle Button (Text-like) -->
    <ControlTheme x:Key="WinXISubtleButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter x:Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}" />
        </Style>
        
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource PressedOverlayBrush}" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                     TEXTBOX STYLES                                ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXITextBox" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ControlBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <ScrollViewer x:Name="PART_ScrollViewer"
                                      Grid.Column="0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden">
                            <Panel>
                                <TextBlock x:Name="PART_Watermark"
                                           Text="{TemplateBinding Watermark}"
                                           Foreground="{StaticResource TextTertiaryBrush}"
                                           IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                           Margin="{TemplateBinding Padding}" />
                                <TextPresenter x:Name="PART_TextPresenter"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBrush="{StaticResource AccentBrush}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               TextAlignment="{TemplateBinding TextAlignment}"
                                               Margin="{TemplateBinding Padding}" />
                            </Panel>
                        </ScrollViewer>
                        
                        <!-- Bottom accent border for focus -->
                        <Border x:Name="PART_FocusBorder"
                                Grid.ColumnSpan="2"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="0,0,4,4"
                                IsVisible="False" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
        
        <Style Selector="^:focus /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        
        <Style Selector="^:focus /template/ Border#PART_FocusBorder">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                    COMBOBOX STYLES                                ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource ControlBorderThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        
                        <ContentPresenter x:Name="ContentPresenter"
                                          Grid.Column="0"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding ItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        
                        <!-- Dropdown Arrow -->
                        <Path Grid.Column="1"
                              Data="M 0,0 L 4,4 L 8,0"
                              Stroke="{StaticResource TextSecondaryBrush}"
                              StrokeThickness="1.5"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                        
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                               PlacementTarget="PART_Border"
                               Placement="BottomEdgeAlignedLeft"
                               MinWidth="{Binding Bounds.Width, RelativeSource={RelativeSource TemplatedParent}}"
                               MaxHeight="300"
                               IsLightDismissEnabled="True">
                            <Border Background="{StaticResource SurfacePrimaryBrush}"
                                    BorderBrush="{StaticResource SurfaceStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource OverlayCornerRadius}"
                                    BoxShadow="{StaticResource PopupShadow}"
                                    Padding="4"
                                    Margin="0,4,0,0">
                                <ScrollViewer MaxHeight="300">
                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
        
        <Style Selector="^:focus /template/ Border#PART_Border">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                    CHECKBOX STYLES                                ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXICheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="20,*">
                    <Border x:Name="PART_CheckBorder"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Background="{StaticResource SurfacePrimaryBrush}"
                            BorderBrush="{StaticResource SurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <Path x:Name="PART_CheckMark"
                              Data="M 2,6 L 5,9 L 10,3"
                              Stroke="{StaticResource TextOnAccentBrush}"
                              StrokeThickness="2"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsVisible="False" />
                    </Border>
                    
                    <ContentPresenter x:Name="ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_CheckBorder">
            <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
        
        <Style Selector="^:checked /template/ Border#PART_CheckBorder">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        
        <Style Selector="^:checked /template/ Path#PART_CheckMark">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                   RADIOBUTTON STYLES                              ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="20,*">
                    <Border x:Name="PART_RadioBorder"
                            Grid.Column="0"
                            Width="20"
                            Height="20"
                            Background="{StaticResource SurfacePrimaryBrush}"
                            BorderBrush="{StaticResource SurfaceStrokeBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Ellipse x:Name="PART_RadioDot"
                                 Width="10"
                                 Height="10"
                                 Fill="{StaticResource AccentBrush}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="False" />
                    </Border>
                    
                    <ContentPresenter x:Name="ContentPresenter"
                                      Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Grid>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_RadioBorder">
            <Setter Property="BorderBrush" Value="{StaticResource TextTertiaryBrush}" />
        </Style>
        
        <Style Selector="^:checked /template/ Border#PART_RadioBorder">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        
        <Style Selector="^:checked /template/ Ellipse#PART_RadioDot">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                     SLIDER STYLES                                 ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXISlider" TargetType="Slider">
        <Setter Property="Background" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="MinHeight" Value="32" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Border x:Name="PART_TrackBackground"
                            Height="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            VerticalAlignment="Center" />
                    
                    <Track x:Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           Orientation="{TemplateBinding Orientation}">
                        <Track.DecreaseButton>
                            <RepeatButton>
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Height="4"
                                                Background="{StaticResource AccentBrush}"
                                                CornerRadius="2" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton>
                                <RepeatButton.Template>
                                    <ControlTemplate>
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </RepeatButton.Template>
                            </RepeatButton>
                        </Track.IncreaseButton>
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate>
                                        <Border x:Name="ThumbBorder"
                                                Width="20"
                                                Height="20"
                                                Background="{StaticResource SurfacePrimaryBrush}"
                                                BorderBrush="{StaticResource AccentBrush}"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                BoxShadow="0 1 4 0 #30000000" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                   PROGRESSBAR STYLES                              ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIProgressBar" TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="MinHeight" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Border x:Name="PART_Indicator"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            HorizontalAlignment="Left" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                       CARD STYLES                                 ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXICard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
        <Setter Property="BoxShadow" Value="{StaticResource CardShadow}" />
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                      LISTBOX STYLES                               ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Margin" Value="2" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}" />
        </Style>
        
        <Style Selector="^:selected /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource SelectedOverlayBrush}" />
        </Style>
        
        <Style Selector="^:selected:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource PressedOverlayBrush}" />
        </Style>
    </ControlTheme>
    
    <ControlTheme x:Key="WinXIListBox" TargetType="ListBox">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="4" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ScrollViewer>
                        <ItemsPresenter Margin="{TemplateBinding Padding}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                     TABCONTROL STYLES                             ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXITabItem" TargetType="TabItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="FontWeight" Value="{StaticResource MediumFontWeight}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <Grid RowDefinitions="*,2">
                        <ContentPresenter Grid.Row="0"
                                          Content="{TemplateBinding Header}" />
                        <Border x:Name="PART_Indicator"
                                Grid.Row="1"
                                Height="2"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="1"
                                Margin="0,4,0,0"
                                IsVisible="False" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        </Style>
        
        <Style Selector="^:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        
        <Style Selector="^:selected /template/ Border#PART_Indicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                     EXPANDER STYLES                               ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIExpander" TargetType="Expander">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid RowDefinitions="Auto,Auto">
                        <!-- Header -->
                        <ToggleButton Grid.Row="0"
                                      IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalContentAlignment="Stretch"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="{TemplateBinding Padding}">
                            <Grid ColumnDefinitions="*,Auto">
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding Header}" />
                                <Path x:Name="ExpanderArrow"
                                      Grid.Column="1"
                                      Data="M 0,0 L 4,4 L 8,0"
                                      Stroke="{StaticResource TextSecondaryBrush}"
                                      StrokeThickness="1.5"
                                      VerticalAlignment="Center"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </ToggleButton>
                        
                        <!-- Content -->
                        <Border x:Name="PART_ContentBorder"
                                Grid.Row="1"
                                IsVisible="{TemplateBinding IsExpanded}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:expanded /template/ Path#ExpanderArrow">
            <Setter Property="RenderTransform">
                <RotateTransform Angle="180" />
            </Setter>
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                      MENU STYLES                                  ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIMenuItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Border"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <ContentPresenter x:Name="PART_IconPresenter"
                                          Grid.Column="0"
                                          Content="{TemplateBinding Icon}"
                                          Margin="0,0,12,0"
                                          IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Header}" />
                        
                        <TextBlock Grid.Column="2"
                                   Text="{TemplateBinding InputGesture}"
                                   Foreground="{StaticResource TextTertiaryBrush}"
                                   Margin="24,0,0,0"
                                   IsVisible="{TemplateBinding InputGesture, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource HoverOverlayBrush}" />
        </Style>
        
        <Style Selector="^:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{StaticResource PressedOverlayBrush}" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- ╔═══════════════════════════════════════════════════════════════════╗
         ║                    TOOLTIP STYLES                                 ║
         ╚═══════════════════════════════════════════════════════════════════╝ -->
    
    <ControlTheme x:Key="WinXIToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource SurfacePrimaryBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        BoxShadow="{StaticResource PopupShadow}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
