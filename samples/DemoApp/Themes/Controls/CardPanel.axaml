<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:DemoApp.Controls">

  <!-- CardPanel Control Theme -->
  <ControlTheme x:Key="{x:Type controls:CardPanel}" TargetType="controls:CardPanel">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
    <Setter Property="Padding" Value="0" />

    <Setter Property="Template">
      <ControlTemplate TargetType="controls:CardPanel">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                BoxShadow="{DynamicResource CardShadow}"
                ClipToBounds="True">
          <Grid RowDefinitions="Auto,*">

            <!-- Card Header -->
            <Border x:Name="PART_Header"
                    Grid.Row="0"
                    Background="{DynamicResource RibbonBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,10"
                    IsVisible="{TemplateBinding ShowHeader}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Collapse/Expand Button -->
                <Button x:Name="PART_CollapseButton"
                        Grid.Column="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="4"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        IsVisible="{TemplateBinding CanCollapse}">
                  <PathIcon Width="10" Height="10"
                            Data="M0,0 L5,5 L10,0"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <!-- Title -->
                <TextBlock Grid.Column="1"
                           Text="{TemplateBinding Title}"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />

                <!-- Search Box -->
                <TextBox x:Name="PART_SearchBox"
                         Grid.Column="2"
                         Theme="{DynamicResource WinXISearchBox}"
                         Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                         PlaceholderText="{TemplateBinding SearchWatermark}"
                         MinHeight="30"
                         MinWidth="220"
                         VerticalAlignment="Center"
                         IsVisible="{TemplateBinding ShowSearch}" />
              </Grid>
            </Border>

            <!-- Card Content -->
            <ContentPresenter x:Name="PART_ContentPresenter"
                              Grid.Row="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
