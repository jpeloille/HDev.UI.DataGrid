<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Package Info -->
    <PackageId>HDev.UI.DataGrid</PackageId>
    <Version>1.0.0</Version>
    <Description>A feature-rich DataGrid control for Avalonia UI inspired by DevExpress</Description>
    <PackageTags>avalonia;datagrid;ui;controls</PackageTags>
    
    <!-- Enable AXAML compilation -->
    <EnableAvaloniaCompilationBindings>true</EnableAvaloniaCompilationBindings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Interaction" />
  </ItemGroup>

  <!-- Include all AXAML files as Avalonia resources -->
  <ItemGroup>
    <AvaloniaResource Include="**/*.axaml" />
  </ItemGroup>

</Project>
